{
  "name": "ultimate-sim-app",
  "version": "2.49.0",
  "description": "Ultimate Sim App — Windows desktop companion for sim racing: telemetry, overlays, dashboards, strategy, and the SIM-X ButtonBox.",
  "main": "out/main/index.js",
  "author": "Guilherme Basso",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist:win": "bash scripts/fetch-win-llama.sh && bash scripts/fetch-win-whisper.sh && bash scripts/fetch-win-sherpa.sh && bash scripts/verify-win-tts.sh && (bash scripts/fetch-win-sharp.sh || true) && electron-vite build && electron-builder --win --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "palette": "node scripts/extract-palette.mjs",
    "assets:instruments": "bash scripts/gen-instrument-assets.sh",
    "visual:diff": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "visual:capture": "node scripts/capture-widgets.mjs",
    "visual:widgets": "node visual-audit/lint-overflow.mjs",
    "visual:contact": "node visual-audit/contact-sheet.mjs",
    "visual:dash": "node visual-audit/shoot-dashboards.mjs",
    "visual:touch": "node visual-audit/shoot-touchpanels.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/d3-shape": "^3.1.8",
    "@xenova/transformers": "^2.17.2",
    "bonjour-service": "^1.2.1",
    "d3-shape": "^3.2.0",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "koffi": "^2.14.0",
    "lucide-react": "^1.23.0",
    "node-llama-cpp": "^3.18.1",
    "onnxruntime-node": "^1.27.0",
    "pixi.js": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "seek-bzip": "^2.0.0",
    "serialport": "^12.0.0",
    "sherpa-onnx-node": "^1.13.3",
    "three": "^0.185.1",
    "unzipper": "^0.12.3",
    "uplot": "^1.6.32",
    "ws": "^8.21.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "jimp": "^0.22.12",
    "node-vibrant": "^4.0.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "latest",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "vigemclient": "^1.0.0"
  }
}
