{
  "name": "ultimate-sim-app",
  "version": "2.57.0",
  "description": "Ultimate Sim App — Windows desktop companion for sim racing: telemetry, overlays, dashboards, strategy, and the SIM-X ButtonBox.",
  "main": "out/main/index.js",
  "author": "Guilherme Basso",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build && node scripts/verify-stream-resource-graph.mjs && node scripts/verify-passport-worker.mjs",
    "dev": "electron-vite dev",
    "dist:win": "bash scripts/fetch-win-cloudflared.sh && bash scripts/fetch-win-llama.sh && bash scripts/fetch-win-whisper.sh && bash scripts/fetch-win-sherpa.sh && bash scripts/verify-win-tts.sh && (bash scripts/fetch-win-sharp.sh || true) && npm run build && bash scripts/fetch-win-cloudflared.sh --verify && electron-builder --win --publish never",
    "verify:win-package": "bash scripts/fetch-win-cloudflared.sh --verify-package",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "test": "npm run test:unit && npm run test:ledger-performance",
    "test:unit": "vitest run --exclude src/shared/visual-artifact-ledger/performance.test.ts",
    "test:ledger-performance": "vitest run src/shared/visual-artifact-ledger/performance.test.ts --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "check:encoding": "node ../scripts/check-encoding.mjs",
    "dashboard:identity-catalog": "node scripts/generate-dashboard-identity-catalog.mjs",
    "palette": "node scripts/extract-palette.mjs",
    "assets:instruments": "bash scripts/gen-instrument-assets.sh",
    "visual:diff": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "visual:capture": "node scripts/capture-widgets.mjs",
    "visual:release-a-triggers": "node scripts/capture-release-a-triggers.mjs",
    "visual:widgets": "node visual-audit/lint-overflow.mjs",
    "visual:contact": "node visual-audit/contact-sheet.mjs",
    "visual:dash": "node visual-audit/shoot-dashboards.mjs",
    "visual:touch": "node visual-audit/shoot-touchpanels.mjs",
    "racecon:capture:rc01": "node visual-audit/racecon-rc01-capture.mjs",
    "racecon:capture:rc02": "node visual-audit/racecon-rc02-capture.mjs",
    "racecon:capture:rc03": "node visual-audit/racecon-rc03-capture.mjs",
    "racecon:capture:rc04": "node visual-audit/racecon-rc04-capture.mjs",
    "racecon:capture:rc05": "node visual-audit/racecon-rc05-capture.mjs",
    "racecon:capture:rc06": "node visual-audit/racecon-rc06-capture.mjs",
    "racecon:capture:rc07": "node visual-audit/racecon-rc07-capture.mjs",
