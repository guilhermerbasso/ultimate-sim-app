          "id": "pit-window-readiness",
          "version": "1.0.0",
          "title": "Pit Window Readiness",
          "summary": "Preview a bounded pit-window reminder without sending controls, network traffic, or gameplay input.",
          "author": "Ultimate Sim App",
          "compatibility": {
            "app": {
              "min": "2.53.0",
              "max": "2.99.99"
            },
            "runtime": 1
          },
          "capabilities": [
            "telemetry.fuel.read",
            "telemetry.car-state.read",
            "cue.audio.preview",
            "dashboard.state.preview",
            "stream.card.preview"
          ],
          "parameters": [
            {
              "id": "pit-window-laps",
              "label": "Pit-window threshold",
              "description": "Preview when estimated fuel laps remaining reaches this value.",
              "type": "number",
              "default": 4,
              "min": 2,
              "max": 10,
              "step": 1,
              "unit": "laps"
            },
            {
              "id": "require-window-open",
              "label": "Required strategy-window state",
              "description": "Choose the declared pit-window state that the synthetic fixture must match.",
              "type": "boolean",
              "default": true
            },
            {
              "id": "strategy-mode",
              "label": "Strategy mode",
              "type": "enum",
              "default": "team-call",
              "options": [
                {
                  "value": "team-call",
                  "label": "Team call"
                },
                {
                  "value": "driver-reminder",
                  "label": "Driver reminder"
                }
              ]
            }
          ],
          "workflow": {
            "mode": "rising-edge",
            "trigger": {
              "id": "detect-pit-threshold",
              "field": "fuel.lapsRemaining",
              "operator": "lte",
              "value": {
                "parameter": "pit-window-laps"
              }
            },
            "conditions": [
              {
                "id": "require-open-window",
                "field": "fuel.pitWindowOpen",
                "operator": "eq",
                "value": {
                  "parameter": "require-window-open"
                }
              },
              {
                "id": "exclude-pit-road",
                "field": "car.onPitRoad",
                "operator": "eq",
                "value": false
              }
            ],
            "actions": [
              {
                "id": "preview-pit-cue",
                "kind": "cue",
                "channel": "audio",
                "severity": "warning",
                "message": "Pit window in {{param.pit-window-laps}} laps · {{param.strategy-mode}}"
              },
              {
                "id": "preview-pit-dashboard",
                "kind": "dashboard-state",
                "state": "pit-window"
              },
              {
                "id": "preview-pit-card",
                "kind": "stream-card",
                "title": "Pit window preview",
                "body": "{{param.strategy-mode}} · threshold {{param.pit-window-laps}} laps"
              }
            ]
          },
