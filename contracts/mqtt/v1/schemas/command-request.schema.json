{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultimate-sim:mqtt:v1:command-request",
  "title": "Ultimate Sim MQTT Command Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "capability", "issuedAt", "expiresAt", "args"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$" },
    "capability": {
      "enum": ["app.overlay.show", "app.overlay.hide"]
    },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 },
    "args": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
